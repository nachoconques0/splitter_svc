# Every variable here already has a default in docker-compose.yml; copy this file
# to .env only to override one. The API itself has no defaults for the database
# credentials — see the config package — so a deployment that forgets them is
# told which ones at startup rather than failing later against an empty password.

# Port the app is served on. Change it if 8080 is taken.
WEB_PORT=8080

# Port Postgres is published on, for the make migrate-* targets. Not 5432, because
# a local Postgres is usually already there and the clash is a silent one.
DB_HOST_PORT=5433

DB_USER=splitter
DB_PASSWORD=splitter
DB_NAME=splitter

LOG_LEVEL=info
